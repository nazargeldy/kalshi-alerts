# Copy this file to .env and fill in your values

KALSHI_ENV=prod
KALSHI_KEY_ID=your-key-id-here
KALSHI_PRIVATE_KEY_PATH=/home/ubuntu/kalshi_alerts/kalshi_priv.pem

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Alert Mode: "prod" or "debug"
ALERT_MODE=prod
#ALERT_MODE=debug
DEBUG_SAMPLE_EVERY=20
DEBUG_MIN_CONTRACTS=200
DEBUG_MAX_PER_MIN=3
